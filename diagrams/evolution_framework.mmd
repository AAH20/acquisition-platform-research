flowchart TD
    subgraph Input["Input"]
        DATA[Research Data<br/>Entities + Financials]
        BENCH[Benchmark Target<br/>evolution.py]
        PARAMS[Parameters<br/>config.py]
    end

    subgraph Evolution["Evolution Engine<br/>evolution.py"]
        INIT[Initialize Population<br/>Random Genes]
        EVAL[Evaluate Fitness<br/>fitness_fn]
        SELECT[Tournament Selection<br/>Pick Best of 2]
        CROSS[Uniform Crossover<br/>Average Parents]
        MUTATE[Gaussian Mutation<br/>+ Clamp to Range]
        REPLACEMENT[Elitism + Replacement<br/>Keep Top N]
        CONVERGE[Convergence Check<br/>Stagnation >= 5]
    end

    subgraph Evaluation["Evaluation Framework"]
        METRICS[Metrics Calculator<br/>best/worst/diversity]
        COMPARISON[Benchmark Comparison<br/>Benchmark.evaluate]
        RANKING[Result Ranking<br/>Score Descending]
        VISUAL[Visualization<br/>reporting.py]
    end

    subgraph Output["Output"]
        BEST[Best Solution<br/>Hyperparameters]
        REPORT[Report<br/>reporting.py]
        DEPLOY[Deployment<br/>API/CLI]
    end

    subgraph System["System Integration"]
        INIT_PKG[Package Init<br/>__init__.py]
        ORCH[Orchestrator<br/>orchestrator.py]
        API[REST API<br/>api.py]
        CLI[CLI<br/>__main__.py]
        NOTIF[Notifications<br/>notifications.py]
        OBS[Observability<br/>observability.py]
        CACHE[Caching<br/>caching.py]
        BATCH[Batch Processing<br/>batch.py]
        SEC[Security<br/>security.py]
        SER[Serialization<br/>serialization.py]
        EXC[Exceptions<br/>exceptions.py]
        SCHEMAS[Schemas<br/>schemas.py]
        IO[Data I/O<br/>data_io.py]
        MATCH[Matching<br/>matching.py]
        VAL[Valuation<br/>valuation.py]
        FRAUD[Fraud Detection<br/>fraud_detection.py]
        PORT[Portfolio Opt<br/>portfolio_optimizer.py]
        PRICE[Pricing<br/>dynamic_pricing.py]
        ER[Entity Resolution<br/>entity_resolution.py]
        RANK[Ranking<br/>search_ranking.py]
        AUC[Auction Design<br/>auction_design.py]
        DD[Due Diligence<br/>due_diligence.py]
        XB[Cross-Border<br/>cross_border.py]
        REC[Recommendation<br/>recommendation.py]
    end

