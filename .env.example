# Acquisition Platform Environment Variables
# Copy to .env and fill in values
# All values shown are the defaults

# Global settings
ACQ_LOG_LEVEL=INFO
ACQ_RANDOM_SEED=
ACQ_OUTPUT_FORMAT=json

# Fraud detection
ACQ_FRAUD_WEIGHTS={"identity_verified": 0.3, "financial_consistency": 0.3, "traffic_authenticity": 0.2}
ACQ_FRAUD_DEFAULT_WEIGHT=0.1
ACQ_FRAUD_TOTAL_EXPECTED_SIGNALS=3
ACQ_FRAUD_RISK_THRESHOLD_LOW=0.3
ACQ_FRAUD_RISK_THRESHOLD_MEDIUM=0.7
ACQ_FRAUD_RING_RISK_SCORE=0.8
ACQ_FRAUD_NO_RING_SCORE=0.1

# Portfolio optimization
ACQ_PORTFOLIO_MAX_ASSETS=10
ACQ_PORTFOLIO_RISK_TOLERANCE=0.5
ACQ_PORTFOLIO_DIVERSIFICATION_BONUS=1.5
ACQ_PORTFOLIO_RISK_EPSILON=0.01
ACQ_PORTFOLIO_SHARPE_EPSILON=0.01

# Dynamic pricing
ACQ_PRICING_DEMAND_MULTIPLIER_BASE=0.8
ACQ_PRICING_DEMAND_MULTIPLIER_SCALE=0.4
ACQ_PRICING_COMPETITION_MULTIPLIER_BASE=1.2
ACQ_PRICING_COMPETITION_MULTIPLIER_SCALE=0.4
ACQ_PRICING_MARKET_MULTIPLIER_BULL=1.15
ACQ_PRICING_MARKET_MULTIPLIER_BEAR=0.85
ACQ_PRICING_MARKET_MULTIPLIER_NORMAL=1.0
ACQ_PRICING_FLOOR_FACTOR=0.7
ACQ_PRICING_CEILING_FACTOR=1.5

# Entity resolution
ACQ_ENTITY_THRESHOLD=0.85
ACQ_ENTITY_BLOCKING_PREFIX_LENGTH=3
ACQ_ENTITY_DOMAIN_MATCH_BONUS=0.2
ACQ_ENTITY_JW_PREFIX_LENGTH=4
ACQ_ENTITY_JW_BOOST_FACTOR=0.1

# Search ranking
ACQ_RANKING_DIVERSITY_FACTOR_FIRST=1.0
ACQ_RANKING_DIVERSITY_FACTOR_SUBSEQUENT=0.7
ACQ_RANKING_PERSONALIZATION_FACTOR=1.3

# Matching
ACQ_MATCHING_CATEGORY_BONUS=1.0
ACQ_MATCHING_CONFIDENCE_HALF_BUDGET_DIVISOR=2.0

# Valuation
ACQ_VALUATION_DCF_CONFIDENCE=0.7
ACQ_VALUATION_DCF_LOW_FACTOR=0.85
ACQ_VALUATION_DCF_HIGH_FACTOR=1.15
ACQ_VALUATION_COMPS_CONFIDENCE=0.6
ACQ_VALUATION_COMPS_LOW_FACTOR=0.85
ACQ_VALUATION_COMPS_HIGH_FACTOR=1.15
ACQ_VALUATION_SDE_CONFIDENCE=0.6
ACQ_VALUATION_SDE_LOW_FACTOR=0.85
ACQ_VALUATION_SDE_HIGH_FACTOR=1.15
ACQ_VALUATION_ARR_CONFIDENCE=0.6
ACQ_VALUATION_ARR_LOW_FACTOR=0.85
ACQ_VALUATION_ARR_HIGH_FACTOR=1.15

# Evolution (genetic algorithm)
ACQ_EVOLUTION_POPULATION_SIZE=50
ACQ_EVOLUTION_GENERATIONS=20
ACQ_EVOLUTION_MUTATION_RATE=0.1
ACQ_EVOLUTION_ELITISM=2
ACQ_EVOLUTION_CONVERGENCE_IMPROVEMENT_THRESHOLD=0.001
ACQ_EVOLUTION_CONVERGENCE_STAGNATION_GENERATIONS=5
ACQ_EVOLUTION_CONVERGENCE_MIN_GENERATIONS=10
ACQ_EVOLUTION_MUTATION_SCALE_FACTOR=0.1
